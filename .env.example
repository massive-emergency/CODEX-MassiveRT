PORT=43217
TENANT_ID=massive
CAMPAIGN_TZ=America/Los_Angeles

# Local preview writes JSONL here. On the VPC with MYSQL_PASSWORD set, default is /var/log/massive-rt
HIT_LOG_DIR=var/hits

# Leave MYSQL_PASSWORD empty to use the in-memory store (local preview / tests).
# Set it when pointing at the massive-rt MySQL instance on the VPC.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=massiveRT-RW
MYSQL_PASSWORD=
MYSQL_DATABASE=massive-rt
